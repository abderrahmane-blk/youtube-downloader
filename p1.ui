         <property name="styleSheet">
          <string notr="true">QTabWidget{
background-color:#aaaaaa;
}

QTabWidget::pane { /* Style the area *behind* the tabs (the content area) */
    background-color: #2b2f30; /* background for the pane */
    border: 0px solid white; /* Optional: Add a border to the pane */
}

QTabWidget::tab-bar { /* Style the tab bar itself */
    alignment: center; /* Example: Center the tabs */
    /* Add spacing around the tab bar if needed: padding: 5px; */
}

QTabBar::tab { /* Style individual tabs */
    background-color: #2b2f30; /* Example: Light gray for inactive tabs */
    color: grey; /* Dark text color for inactive tabs */
    border: 1px solid #ccc; /* Optional: Add borders to the tabs */
    border-top-left-radius: 0px; /* Optional: Round the top corners */
    border-top-right-radius: 4px;
    padding: 8px 15px; /* Adjust padding as needed */
    margin-right: 0px; /* Add spacing between tabs */
}

QTabBar::tab:selected { /* Style the selected tab */
    background-color: #2b2f30; /* Example: White background for selected tab */
    color: #007bff; /* Example: Blue text for selected tab */
    border-bottom: 2px solid #007bff; /* Example: Blue underline for selected tab */
}

QTabBar::tab:hover { /* Style tabs on hover */
    background-color: #1b1f10; /* Example: Slightly lighter background on hover */
}</string>
