                  <property name="styleSheet">
                   <string notr="true">QComboBox {
    border: 1px solid #ccc;
    border-radius: 4px;
    padding: 5px;
    font-size: 14px;
    background-color: white;
}

QComboBox:hover {
    border-color: #999;
}

QComboBox:focus {
    border-color: #0078d4; /* Or your primary color */
    outline: none; /* Remove default focus outline */
    box-shadow: 0 0 3px rgba(0, 120, 212, 0.5); /* Optional subtle glow */
} 

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid rgb(0, 123, 255);
}

QComboBox::down-arrow {
    image: url(your_down_arrow_icon.png); /* Replace with your icon */
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    border: 1px solid #ccc;
    border-radius: 4px;
    background-color: white;
    selection-background-color: #e0e0e0; /* Selected item background */
    selection-color: black;
    outline: 0px;
}

QComboBox QAbstractItemView::item {
    padding: 5px;
    min-height: 20px;


}


