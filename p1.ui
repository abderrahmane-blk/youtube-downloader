QLineEdit {
    background-color: #363b3c; /* Light background */
    border: 1px solid #ced4da; /* Subtle border */
    border-radius: 10px; /* Slightly rounded corners */
    padding: 6px 10px; /* Comfortable padding */
    font-size: 16px; /* Readable font size */
    color: #efefef; /* Dark gray text color */
}

QLineEdit:focus {
    border-color: #80bdff; /* Highlight border on focus */
    outline: none; /* Remove default outline */
    box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25); /* Subtle shadow on focus */
}

QLineEdit::placeholder {
    color: #adb5bd; /* Lighter placeholder color */
}</string>
