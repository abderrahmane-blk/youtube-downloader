                  <property name="styleSheet">
                   <string notr="true">QCheckBox {
    spacing: 5px; /* Space between checkbox and text */
    color: #ffffff; /* Text color */
    font-size: 16px; /* Font size */
}

QCheckBox::indicator {
    width: 20px; /* Width of the checkbox indicator */
    height: 20px; /* Height of the checkbox indicator */
    border: 2px solid #888888; /* Border color */
    border-radius: 3px; /* Rounded corners */
    background-color: #363b3c; /* Background color */
}

QCheckBox::indicator:checked {
    background-color: rgb(39, 141, 220); /* Checked background color */
    border: 2px solid rgb(39, 141, 220);/*Checked border color*/
    image: url(:/f/resources/feather/check-circle.svg); /* Replace with your checkmark icon */
    image-position: center; /* Center the checkmark */
}

QCheckBox::indicator:hover {
    border-color: #80bdff; /* Highlight border on hover */
}

QCheckBox:focus {
    outline: none; /* Remove default focus outline */
}</string>
